# Server environment configuration
# Copy this file to .env and fill in the values
# See docs/DB_SETUP.md for detailed setup instructions

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fitcoach

# API authentication (shared secret between server and bot)
BOT_API_KEY=

# Telegram bot token (shared with bot process; used for Mini App initData validation)
TELEGRAM_TOKEN=

# LLM provider (any OpenAI-compatible API: OpenAI, OpenRouter, Groq, etc.)
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.7

# Episode-memory tunables (P4). Optional — code defaults in parentheses;
# the one documented exception to "no defaults in code" besides LLM_PROFILE_*.
#EPISODE_GAP_HOURS=3        # inactivity gap that ends an episode (BR-LLM-001)
#EPISODE_MIN_TURNS=2        # shorter episodes are trimmed without a summary (D-B)
#EPISODE_MIN_TOKENS=300

# Optional per-profile model overrides — the 'summarizer' profile backs the
# episode summariser (P4): LLM_PROFILE_SUMMARIZER_MODEL, _TEMPERATURE, _MAX_TOKENS
# (same pattern as the other profiles; absent = LLM_MODEL/LLM_TEMPERATURE/default)

