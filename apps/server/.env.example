# Server environment configuration
# Copy this file to .env and fill in the values
# See docs/DB_SETUP.md for detailed setup instructions

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fitcoach

# API authentication (shared secret between server and bot)
BOT_API_KEY=

# Telegram bot token (shared with bot process; used for Mini App initData validation)
TELEGRAM_TOKEN=

# LLM provider (any OpenAI-compatible API: OpenAI, OpenRouter, Groq, etc.)
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.7

# Structured-output request mode for the LLM route. Optional — code default in
# parentheses; same tunables-not-secrets exception as EPISODE_*/LLM_PROFILE_*.
# 'json_schema' sends response_format json_schema (what OpenRouter/Gemini enforces);
# 'json_object' is for providers that ignore json_schema (GLM via Z.AI): response_format
# json_object plus the JSON Schema in one trailing system message (Z.AI's own recipe).
#LLM_STRUCTURED_OUTPUT_MODE=json_schema

# Episode-memory tunables (P4). Optional — code defaults in parentheses;
# the one documented exception to "no defaults in code" besides LLM_PROFILE_*.
#EPISODE_GAP_HOURS=3        # inactivity gap that ends an episode (BR-LLM-001)
#EPISODE_MIN_TURNS=2        # shorter removed parts are kept verbatim, never dropped (AC-CC-1)
#EPISODE_MIN_TOKENS=300
#EPISODE_KEEP_TURNS=6       # verbatim tail every compaction trigger keeps (AC-CC-1)

# Optional per-profile model overrides — the 'summarizer' profile backs the
# episode summariser (P4): LLM_PROFILE_SUMMARIZER_MODEL, _TEMPERATURE, _MAX_TOKENS
# (same pattern as the other profiles; absent = LLM_MODEL/LLM_TEMPERATURE/default)

# Optional per-phase token budget overrides (P4 context-budget plan, ADR-0013
# §3.4, INV-LLM-004) — LLM_BUDGET_<PHASE>_<PART> where PART is one of SYSTEM,
# LONG_TERM, DOMAIN, HISTORY, OUTPUT_RESERVE. Absent = PhaseSpec.budget's
# default (Task 1's measured table in phases/*.spec.ts). Same tunables-not-
# secrets exception as EPISODE_*/LLM_PROFILE_*. Example (uncomment to use):
#LLM_BUDGET_CHAT_HISTORY=9000
#LLM_BUDGET_SESSION_PLANNING_DOMAIN=7000

# Per-userId run mutex wait window (P5, D-A/D-12). Same tunables-not-secrets
# exception as EPISODE_*/LLM_BUDGET_*. A waiter that does not acquire the
# per-userId run mutex within this window rejects with ThreadBusyError
# (HTTP 409 THREAD_BUSY). Code default in parentheses.
#LLM_RUN_MUTEX_WAIT_MS=20000

