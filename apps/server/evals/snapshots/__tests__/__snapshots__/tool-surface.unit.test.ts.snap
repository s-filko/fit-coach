                "type": "string",
              },
              "restSeconds": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "targetReps": {
                "minLength": 1,
                "type": "string",
              },
              "targetSets": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
