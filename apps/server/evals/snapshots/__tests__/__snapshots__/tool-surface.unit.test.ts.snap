exports[`tool surface (pre-executor truth, refactor-p3-tool-executor Task 1) chat tool surface 1`] = `
[
  {
    "description": "Update one or more fields of the user's fitness profile. Call this when the user explicitly tells you their name, age, gender, height, weight, fitness level, or goal — or when they want to change an existing value. Only include fields the user actually mentioned.",
    "name": "update_profile",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "age": {
          "description": "Age in years",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "firstName": {
          "description": "Preferred name or nickname",
          "type": "string",
        },
        "fitnessGoal": {
          "description": "User fitness goal in their own words",
          "type": "string",
        },
        "fitnessLevel": {
          "description": "Self-assessed fitness level",
          "enum": [
            "beginner",
            "intermediate",
            "advanced",
          ],
          "type": "string",
        },
        "gender": {
          "description": "Biological gender",
          "enum": [
            "male",
            "female",
          ],
          "type": "string",
        },
        "height": {
          "description": "Height in cm",
          "type": "number",
        },
        "weight": {
          "description": "Weight in kg",
          "type": "number",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Request a phase transition to another part of the app. Use "plan_creation" when user wants to create or update their workout plan. Use "session_planning" when user wants to plan or start a workout session. Do NOT call this for casual fitness questions — just respond with text.",
    "name": "request_transition",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "description": "Brief reason for the transition",
          "type": "string",
        },
        "toPhase": {
          "description": "Target phase",
          "enum": [
            "plan_creation",
            "session_planning",
          ],
          "type": "string",
        },
      },
      "required": [
        "toPhase",
      ],
      "type": "object",
    },
  },
  {
    "description": "Save the user's timezone. Call when the user provides their city or timezone. Use IANA format, e.g. "Europe/Berlin", "America/New_York", "Asia/Tokyo".",
    "name": "save_timezone",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "description": "IANA timezone string, e.g. "Europe/Berlin"",
          "type": "string",
        },
      },
      "required": [
        "timezone",
      ],
      "type": "object",
    },
  },
]
`;

exports[`tool surface (pre-executor truth, refactor-p3-tool-executor Task 1) plan_creation tool surface 1`] = `
[
  {
    "description": "Search the exercise catalog using semantic (meaning-based) vector search. Use this tool whenever you need to find exercises — during plan creation, session planning, or training. The query should be a short English description of what you are looking for. Examples: "chest compound barbell press", "leg bodyweight squat beginner", "cardio low impact home". Apply filters (category, equipment, muscleGroup) when the context clearly constrains the search. You may call this tool multiple times in a single response to search for different muscle groups. Results include exercise IDs — always use these exact IDs when referencing exercises in other tools.",
    "name": "search_exercises",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "Filter by exercise category: compound, isolation, cardio, functional, mobility.",
          "enum": [
            "compound",
            "isolation",
            "cardio",
            "functional",
            "mobility",
          ],
          "type": "string",
        },
        "equipment": {
          "description": "Filter by required equipment: barbell, dumbbell, bodyweight, machine, cable, none.",
          "enum": [
            "barbell",
            "dumbbell",
            "bodyweight",
            "machine",
            "cable",
            "none",
          ],
          "type": "string",
        },
        "limit": {
          "description": "Maximum number of results to return (default: 10, max: 20).",
          "maximum": 20,
          "minimum": 1,
          "type": "integer",
        },
        "muscleGroup": {
          "description": "Filter to exercises that involve this muscle group (primary or secondary).",
          "enum": [
            "chest",
            "back_lats",
            "back_traps",
            "shoulders_front",
            "shoulders_side",
            "shoulders_rear",
            "quads",
            "hamstrings",
            "glutes",
            "calves",
            "biceps",
            "triceps",
            "forearms",
            "abs",
            "lower_back",
            "core",
            "cardio_system",
            "full_body",
            "lower_body_endurance",
            "core_stability",
          ],
          "type": "string",
        },
        "query": {
          "description": "English description of the exercises you are looking for. E.g. "chest compound barbell".",
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
  },
  {
    "description": "Save the user's approved workout plan to the database. Call this ONLY when the user has explicitly approved the complete plan. Do NOT call this during discussion, proposal, or refinement. All fields (sessionTemplates, recoveryGuidelines, progressionRules) must be complete.",
    "name": "save_workout_plan",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "goal": {
          "description": "Primary goal of the plan",
          "type": "string",
        },
        "name": {
          "description": "Plan name, e.g. "Upper-Lower Split — 4 days/week"",
          "type": "string",
        },
        "progressionRules": {
          "description": "Specific, actionable progression rules",
          "items": {
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
        "recoveryGuidelines": {
          "additionalProperties": false,
          "properties": {
            "cardio": {
              "additionalProperties": false,
              "properties": {
                "maxRestDays": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "minRestDays": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
              },
              "required": [
                "minRestDays",
                "maxRestDays",
              ],
              "type": "object",
            },
            "customRules": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "functional": {
              "additionalProperties": false,
              "properties": {
                "maxRestDays": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "minRestDays": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
              },
              "required": [
                "minRestDays",
                "maxRestDays",
              ],
              "type": "object",
            },
            "highIntensity": {
              "additionalProperties": false,
              "properties": {
                "minRestDays": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
              },
              "required": [
                "minRestDays",
              ],
              "type": "object",
            },
            "majorMuscleGroups": {
              "additionalProperties": false,
              "properties": {
                "maxRestDays": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "minRestDays": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
              },
              "required": [
                "minRestDays",
                "maxRestDays",
              ],
              "type": "object",
            },
            "smallMuscleGroups": {
              "additionalProperties": false,
              "properties": {
                "maxRestDays": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "minRestDays": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
              },
              "required": [
                "minRestDays",
                "maxRestDays",
              ],
              "type": "object",
            },
          },
          "required": [
            "majorMuscleGroups",
            "smallMuscleGroups",
            "highIntensity",
            "customRules",
          ],
          "type": "object",
        },
        "sessionTemplates": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "energyCost": {
                "enum": [
                  "very_low",
                  "low",
                  "medium",
                  "high",
                  "very_high",
                ],
                "type": "string",
              },
              "estimatedDuration": {
                "description": "Total session duration in minutes",
                "maximum": 9007199254740991,
                "minimum": 1,
                "type": "integer",
              },
              "exercises": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "energyCost": {
                      "enum": [
                        "very_low",
                        "low",
                        "medium",
                        "high",
                        "very_high",
                      ],
                      "type": "string",
                    },
                    "estimatedDuration": {
                      "description": "Estimated minutes for this exercise block",
                      "maximum": 9007199254740991,
                      "minimum": 1,
                      "type": "integer",
                    },
                    "exerciseId": {
                      "description": "Exact exercise UUID from the list",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "type": "string",
                    },
                    "exerciseName": {
                      "description": "Exercise name in English",
                      "type": "string",
                    },
                    "notes": {
                      "type": "string",
                    },
                    "restSeconds": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer",
                    },
                    "targetReps": {
                      "description": "Rep range, e.g. "8-10" or "12"",
                      "type": "string",
                    },
                    "targetSets": {
                      "maximum": 9007199254740991,
                      "minimum": 1,
                      "type": "integer",
                    },
                    "targetWeight": {
                      "description": "Starting weight in kg, if applicable",
                      "type": "number",
                    },
                  },
                  "required": [
                    "exerciseId",
                    "exerciseName",
                    "energyCost",
                    "targetSets",
                    "targetReps",
                    "restSeconds",
                    "estimatedDuration",
                  ],
                  "type": "object",
                },
                "minItems": 1,
                "type": "array",
              },
              "focus": {
                "description": "Focus description, e.g. "Push: chest, shoulders, triceps"",
                "type": "string",
              },
              "key": {
                "description": "Unique session key, e.g. "upper_a", "lower_b", "full_body_1"",
                "type": "string",
              },
              "name": {
                "description": "Human-readable session name",
                "type": "string",
              },
            },
            "required": [
              "key",
              "name",
              "focus",
              "energyCost",
              "estimatedDuration",
              "exercises",
            ],
            "type": "object",
          },
          "maxItems": 7,
          "minItems": 2,
          "type": "array",
        },
        "targetMuscleGroups": {
          "description": "Primary muscle groups targeted",
          "items": {
            "enum": [
              "chest",
              "back_lats",
              "back_traps",
              "shoulders_front",
              "shoulders_side",
              "shoulders_rear",
              "quads",
              "hamstrings",
              "glutes",
              "calves",
              "biceps",
              "triceps",
              "forearms",
              "abs",
              "lower_back",
              "core",
              "cardio_system",
              "full_body",
              "lower_body_endurance",
              "core_stability",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "trainingStyle": {
          "description": "Training style, e.g. "Upper-Lower Split", "PPL"",
          "type": "string",
        },
      },
      "required": [
        "name",
        "goal",
        "trainingStyle",
        "targetMuscleGroups",
        "recoveryGuidelines",
        "sessionTemplates",
        "progressionRules",
      ],
      "type": "object",
    },
  },
  {
    "description": "Request a phase transition. Use "chat" if the user explicitly cancels plan creation and wants to go back to chat.",
    "name": "request_transition",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
