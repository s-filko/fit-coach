          ],
          "type": "string",
        },
        "query": {
          "description": "English description of the exercises you are looking for. E.g. "chest compound barbell".",
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
  },
  {
    "description": "Create a training session with the approved workout plan and transition to the training phase. Call this ONLY when the user has explicitly approved the session plan and is ready to start. Do NOT call this during discussion, proposal, or plan refinement. Include the complete session plan as arguments — it will be stored with the session.",
    "name": "start_training_session",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "estimatedDuration": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "exercises": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "exerciseId": {
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
              "exerciseName": {
                "minLength": 1,
                "type": "string",
              },
              "imageUrl": {
                "format": "uri",
                "type": "string",
              },
              "notes": {
                "type": "string",
              },
              "restSeconds": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "targetReps": {
                "minLength": 1,
                "type": "string",
              },
              "targetSets": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "targetWeight": {
                "anyOf": [
                  {
                    "type": "number",
                  },
                  {
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "videoUrl": {
                "format": "uri",
                "type": "string",
              },
            },
            "required": [
              "exerciseId",
              "targetSets",
              "targetReps",
              "restSeconds",
            ],
            "type": "object",
          },
          "minItems": 1,
          "type": "array",
        },
        "modifications": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "reasoning": {
          "minLength": 1,
          "type": "string",
        },
        "sessionKey": {
          "minLength": 1,
          "type": "string",
        },
        "sessionName": {
          "minLength": 1,
          "type": "string",
        },
        "timeLimit": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "warnings": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "sessionKey",
        "sessionName",
        "reasoning",
        "exercises",
        "estimatedDuration",
      ],
      "type": "object",
    },
  },
  {
    "description": "Request a phase transition. Use "chat" if the user explicitly cancels session planning and wants to go back to chat.",
    "name": "request_transition",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "description": "Brief reason for the transition",
          "type": "string",
        },
