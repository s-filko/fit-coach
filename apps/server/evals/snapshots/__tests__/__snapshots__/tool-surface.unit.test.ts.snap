  {
    "description": "Log a completed set for the current exercise. Identify the exercise with exerciseId ONLY when you have its exact UUID — copied verbatim from the SESSION PLAN or from a search_exercises result ("ID:..." line). If the exercise is not in the plan and you do not have its exact UUID, pass exerciseName instead (the server resolves it in the catalog) — never invent or guess a UUID. For strength/weighted exercises: provide reps and weight (in kg). For bodyweight exercises: provide reps only. For cardio duration (bike, elliptical): provide durationSeconds only. For cardio distance (treadmill, running): provide distanceKm. durationSeconds is optional — if unknown, log without it and ask the user. Optionally: inclinePct (treadmill only). setNumber is computed automatically — do NOT pass it. Call once per set. For multiple sets reported at once, call log_set multiple times.",
    "name": "log_set",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "distanceKm": {
          "description": "Distance in km — only for cardio_distance exercises (treadmill, running). Triggers cardio_distance set type when combined with durationSeconds.",
          "exclusiveMinimum": 0,
          "type": "number",
        },
        "durationSeconds": {
          "description": "Duration in seconds — for cardio exercises.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "exerciseId": {
          "description": "Exercise UUID copied verbatim from the session plan or search_exercises results. Never invent one.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "exerciseName": {
          "description": "Exercise name — use when the exercise is not in the session plan and its exact UUID is unknown.",
          "type": "string",
        },
        "feedback": {
          "description": "Any user comment about this set.",
          "type": "string",
        },
        "inclinePct": {
          "description": "Treadmill incline in percent (0–30). Only for treadmill. Do NOT use for strength exercises.",
          "maximum": 30,
          "minimum": 0,
          "type": "number",
        },
        "order": {
          "description": "Execution order when logging multiple sets in one response. First set = 1, second = 2, etc. Required when calling log_set more than once per response.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
        "reps": {
          "description": "Number of repetitions performed.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "rpe": {
          "description": "Rate of Perceived Exertion (1–10).",
          "maximum": 10,
          "minimum": 1,
          "type": "number",
        },
        "weight": {
          "description": "Weight used in kilograms (kg). Omit for bodyweight exercises.",
          "exclusiveMinimum": 0,
          "type": "number",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Mark the current in-progress exercise as completed. Call ONLY when the user explicitly says they are done with this exercise ("next", "done with this", "moving on", "following exercise"). Do NOT call automatically after the planned number of sets — wait for the user.",
    "name": "complete_current_exercise",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
  },
  {
    "description": "Complete the training session and return to chat. Call when: (1) user confirms they are done training, OR (2) session is stale and user wants to move on. Do NOT call before explicit user confirmation or clear intent to start a new topic.",
    "name": "finish_training",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "feedback": {
          "description": "Optional session feedback from the user.",
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Delete the last N logged sets for a given exercise in the current session. Use this when the user says a set was logged by mistake or wants to correct a logging error. Default count is 1 (deletes only the most recent set).",
    "name": "delete_last_sets",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "count": {
          "description": "How many of the most recent sets to delete (default: 1)",
          "maximum": 10,
          "minimum": 1,
          "type": "integer",
        },
        "exercise_id": {
          "description": "The UUID of the exercise whose sets should be deleted",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
      },
      "required": [
        "exercise_id",
      ],
      "type": "object",
    },
  },
  {
    "description": "Correct the last logged set for a given exercise — update weight, reps, RPE, feedback, or cardio fields. Use this when the user says they entered wrong numbers, or to add missing duration to a cardio_distance set logged without time. Only provide the fields you want to change; others remain unchanged.",
    "name": "update_last_set",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "distanceKm": {
          "description": "Distance in km — use to correct distance on a cardio_distance set",
          "exclusiveMinimum": 0,
          "type": "number",
        },
        "durationSeconds": {
          "description": "Duration in seconds — use to add missing time to a cardio_distance set",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "exercise_id": {
          "description": "The UUID of the exercise whose last set should be updated",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "feedback": {
          "description": "Updated feedback note from the user",
          "type": "string",
        },
        "inclinePct": {
          "description": "Treadmill incline in percent — use to add/correct incline on a cardio_distance set",
          "maximum": 30,
          "minimum": 0,
          "type": "number",
        },
        "reps": {
          "description": "New rep count (if correcting reps)",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "rpe": {
          "description": "New RPE value (if correcting perceived exertion)",
          "maximum": 10,
          "minimum": 1,
          "type": "number",
        },
        "weight": {
          "description": "New weight in kg (if correcting weight)",
          "type": "number",
        },
      },
      "required": [
        "exercise_id",
      ],
      "type": "object",
    },
  },
  {
    "description": "Save the user's timezone. Call when the user provides their city or timezone. Use IANA format, e.g. "Europe/Berlin", "America/New_York", "Asia/Tokyo".",
    "name": "save_timezone",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "description": "IANA timezone string, e.g. "Europe/Berlin"",
          "type": "string",
        },
      },
      "required": [
        "timezone",
      ],
      "type": "object",
    },
  },
  {
    "description": "Manage the durable facts you remember about the user. operation "save": store a fact the user just stated, or CORRECT an existing one (same meaning, new details — pass the corrected text). Pick durability by what the user described: "permanent" only for irreversible conditions (say so only when the user stated it explicitly — otherwise the call is rejected); "long_term" for injuries/recoveries measured in weeks or months (pass reviewInDays and a short phaseNote); "short" for states that resolve in days (pass ttlDays and on_expiry: "forget" for things that certainly pass like soreness or bad sleep, "ask_once" for a tweak or pain under load that may leave a trace). operation "retract": the user says a fact is no longer true or applies ("that is fine now", "stop using that") — the fact is ARCHIVED: kept in history, never used or asked about again. operation "delete": the user explicitly does not want a fact STORED at all ("erase that", privacy) — the fact is removed entirely, no trace. For retract/delete, identify the fact EITHER by factId (copied verbatim from a list_facts line, which starts with "- id <uuid>:") OR by factQuery — the distinctive words of what the user called it (e.g. "lower back"); if several facts match the query you will get their ids back — re-call with the right one. Never tell the user a fact was removed unless the tool call succeeded. retract and delete are DIFFERENT operations: if it is unclear which the user means, DO NOT call the tool — ask them first ("should I stop using this fact, or erase it completely?"). For delete, set confirmed=true ONLY after the user explicitly confirmed permanent erasure.",
    "name": "manage_fact",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "For save: the fact category.",
          "enum": [
            "physical_constraint",
            "exercise_preference",
            "exercise_dislike",
            "physiological_pattern",
            "coaching_preference",
            "schedule_constraint",
            "equipment",
            "nutrition_preference",
          ],
          "type": "string",
        },
        "confirmed": {
          "description": "For delete: true ONLY after the user explicitly confirmed permanent erasure.",
          "type": "boolean",
        },
        "context": {
          "description": "For save: a short "how we learned this".",
          "type": "string",
        },
        "durability": {
          "description": "For save: how long the fact holds (see the tool description for how to choose).",
          "enum": [
            "permanent",
            "long_term",
            "short",
          ],
          "type": "string",
        },
        "explicitPermanent": {
          "description": "For save + permanent: true when the user explicitly stated irreversibility.",
          "type": "boolean",
        },
        "fact": {
          "description": "For save: the fact in one clear sentence.",
          "minLength": 3,
          "type": "string",
        },
        "factId": {
          "description": "For retract/delete, and for save when CORRECTING an existing fact: the fact id, verbatim from list_facts.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "factQuery": {
          "description": "For retract/delete without a factId: what the user called the fact, in its own distinctive words (e.g. "lower back").",
          "minLength": 3,
          "type": "string",
        },
        "muscleGroup": {
          "description": "For save: the muscle group, when the fact is anatomical.",
          "type": "string",
        },
        "onExpiry": {
          "description": "For save + short: what happens on expiry.",
          "enum": [
            "forget",
            "ask_once",
          ],
          "type": "string",
        },
        "operation": {
          "description": "What to do with the fact.",
          "enum": [
            "save",
            "retract",
            "delete",
          ],
          "type": "string",
        },
        "phaseNote": {
          "description": "For save + long_term: the recovery phase in the user’s words.",
          "type": "string",
        },
        "reviewInDays": {
          "description": "For save + long_term: days until you should re-ask about it (14–182).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "supersedesFactId": {
          "description": "For save: id of the CLOSED fact this statement replaces (from list_facts).",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "ttlDays": {
          "description": "For save + short: days until it expires (1–14).",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "operation",
      ],
      "type": "object",
    },
  },
  {
    "description": "List the durable facts remembered about the user — use it to answer "what do you remember about me", and to get a fact's id before correcting or retracting it. Every line starts with the fact's id ("- id <uuid>: ..."): copy that id VERBATIM into manage_fact's factId — never invent or abbreviate it. Each fact is listed grouped by category, with its durability class, confirmation count and last-updated date. Set includeArchived=true only when the user asks what used to be remembered: archived facts come with their closure reason.",
    "name": "list_facts",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "includeArchived": {
          "description": "Include archived (closed) facts with their closure reason.",
          "type": "boolean",
        },
      },
      "type": "object",
    },
  },
]
`;
