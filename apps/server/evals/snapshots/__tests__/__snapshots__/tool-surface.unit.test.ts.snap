            "shoulders_side",
            "shoulders_rear",
            "quads",
            "hamstrings",
            "glutes",
            "calves",
            "biceps",
            "triceps",
            "forearms",
            "abs",
            "lower_back",
            "core",
            "cardio_system",
            "full_body",
