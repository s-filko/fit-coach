                    "type": "number",
                  },
                  {
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "videoUrl": {
                "format": "uri",
                "type": "string",
              },
            },
            "required": [
              "exerciseId",
              "targetSets",
              "targetReps",
              "restSeconds",
            ],
            "type": "object",
          },
          "minItems": 1,
          "type": "array",
        },
        "modifications": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "reasoning": {
          "minLength": 1,
          "type": "string",
        },
        "sessionKey": {
          "minLength": 1,
          "type": "string",
        },
        "sessionName": {
          "minLength": 1,
          "type": "string",
        },
        "timeLimit": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "warnings": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "sessionKey",
        "sessionName",
        "reasoning",
        "exercises",
        "estimatedDuration",
      ],
      "type": "object",
    },
  },
