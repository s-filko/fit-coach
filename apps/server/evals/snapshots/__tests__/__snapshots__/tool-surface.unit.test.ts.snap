                    "restSeconds",
                    "estimatedDuration",
                  ],
                  "type": "object",
                },
                "minItems": 1,
                "type": "array",
              },
              "focus": {
                "description": "Focus description, e.g. "Push: chest, shoulders, triceps"",
                "type": "string",
              },
