{
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(npx -p typescript tsc:*)",
      "Bash(npm test:*)",
      "Bash(npx jest:*)",
      "Bash(git status:*)",
      "Bash(npx tsc:*)",
      "Bash(npx -w apps/server tsc:*)",
      "Bash(curl:*)",
      "Bash(npx tsx:*)",
      "Bash(source:*)",
      "Bash(echo:*)",
      "Bash(lsof:*)",
      "Bash(pgrep:*)",
      "Bash(node scripts/state.mjs --check)",
      "Bash(git log *)",
      "Bash(cat docs/ORCHESTRATION.md; echo \"=== skill\"; find ~/.claude -path \"*delegate-implementation*\" -name \"SKILL.md\" 2>/dev/null | head; find .claude -path \"*delegate-implementation*\" 2>/dev/null | head)",
      "Bash(bash _p4-run-executor.sh)"
    ]
  },
  "disabledMcpjsonServers": [
    "supabase"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/owner-gate-branch-delete.sh"
          }
        ]
      }
    ]
  }
}
